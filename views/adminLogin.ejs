<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JanSetu | Admin Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#111111',
            accent: '#f97316',
            offwhite: '#f5f5f5',
            brand: '#1c1c1c',
            'brand-light': '#383838',
            admin: '#0f172a',   // Deep Slate Navy for Admin
            'admin-light': '#1e293b'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="bg-admin text-offwhite font-sans flex items-center justify-center min-h-screen">

  <!-- Login Card -->
  <div class="bg-admin-light rounded-3xl shadow-2xl p-10 md:p-16 w-full max-w-md text-center border border-gray-700">
    
    <!-- Admin Badge -->
    <div class="mb-4 flex justify-center">
      <span class="px-4 py-1 rounded-full text-xs font-bold bg-accent text-white uppercase tracking-wider shadow">
        Admin Access
      </span>
    </div>

    <h2 class="text-3xl font-extrabold mb-6 text-accent">Admin Login</h2>
    <p class="text-gray-400 mb-8">Restricted area – authorized personnel only</p>

    <!-- Error Message -->
    <% if (typeof error !== 'undefined') { %>
      <div class="mb-6 p-3 rounded-xl bg-red-500/20 text-red-400 text-sm font-medium border border-red-500/40">
        <%= error %>
      </div>
    <% } %>

    <form action="/adminlogin" method="POST" class="space-y-6">
      <div class="text-left">
        <label for="email" class="block text-sm font-medium mb-2">Admin Email</label>
        <input type="email" id="email" name="email" required
          class="w-full px-4 py-3 rounded-xl bg-admin text-white border border-gray-600 focus:ring-2 focus:ring-accent focus:border-accent outline-none transition duration-300 placeholder-gray-400">
      </div>
      <div class="text-left">
        <label for="password" class="block text-sm font-medium mb-2">Password</label>
        <input type="password" id="password" name="password" required
          class="w-full px-4 py-3 rounded-xl bg-admin text-white border border-gray-600 focus:ring-2 focus:ring-accent focus:border-accent outline-none transition duration-300 placeholder-gray-400">
      </div>
      <button type="submit"
        class="w-full py-3 bg-accent text-white rounded-full font-semibold hover:bg-orange-600 transition duration-300 transform hover:-translate-y-1 shadow-lg">
        Login as Admin
      </button>
    </form>

    <!-- Back to Home -->
    <p class="text-gray-400 mt-6 text-sm">
      <a href="/" class="text-accent font-semibold hover:underline">← Back to Home</a>
    </p>
  </div>

</body>
</html>
