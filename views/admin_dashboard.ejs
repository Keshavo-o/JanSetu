<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Admin Dashboard | JanSetu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {   
          colors: {
            primary: '#111111',
            accent: '#f97316',
            offwhite: '#f5f5f5',
            brand: '#1c1c1c',
            'brand-light': '#383838',
            admin: '#0f172a',
            'admin-light': '#1e293b'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body class="bg-admin text-offwhite font-sans min-h-screen">

  <!-- Left Sidebar (Fixed) -->
  <aside class="hidden md:flex flex-col w-64 bg-admin-light border-r border-gray-700 shadow-xl p-6 space-y-6 fixed left-0 top-0 bottom-0">
    <h1 class="text-xl font-bold text-accent mb-4">⚙ Jansetu Admin</h1>
    <nav class="flex-1 space-y-4 overflow-y-auto">
      <a href="/admin" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">📊 Dashboard</a>
      <a href="/admin/reports" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">📝 Reports</a>
      <a href="/admin/community" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">💬 Community</a>
      <a href="/admin/departments" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">🤵 Departments</a>
      <a href="/admin/subadmin" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">👨‍💼 Sub Admins</a>
      <a href="/admin/sendnotification" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">🔔 Send a notification</a>
      <a href="/admin/feedbacks" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">🗣️ Feedbacks</a>
      <a href="/admin/users" class="block px-4 py-2 rounded-lg hover:bg-brand text-gray-300 hover:text-accent transition">👤 Users</a>

      <a href="/admin/profile" class="block px-4 py-2 rounded-lg hover:bg-red-600 text-gray-300 hover:text-white transition">⚙ Profile & Settings</a>
    </nav>
    <p class="text-xs text-gray-500">© JanSetu 2025</p>
  </aside>

  <!-- Right Sidebar (Fixed) -->
  <aside class="hidden lg:flex flex-col w-80 bg-admin-light border-l border-gray-700 shadow-xl p-4 space-y-6 fixed right-0 top-0 bottom-0">
    <h2 class="text-lg font-semibold text-accent">🗺 Map View</h2>
   <div class="bg-brand rounded-xl overflow-hidden border border-gray-700 shadow p-4">
  <a href="admin/view_full_map"><h2 class="font-bold text-lg mb-3 text-accent text-center">View Detailed Map</h2></a>
  <iframe src="admin/map-public-admin" class="w-full h-56 rounded-lg border-0" frameborder="0"></iframe>
</div>



    <h2 class="text-lg font-semibold text-accent">🔧 Analytics Dashboard</h2>
    <div class="bg-brand rounded-xl overflow-hidden border border-gray-700 shadow p-4">
  <a href="admin/detailed_analytics"><h2 class="font-bold text-lg mb-3 text-accent text-center">Detailed Analytics</h2></a>
  <iframe src="admin/analytical_overview" class="w-full h-56 rounded-lg border-0" frameborder="0"></iframe>
</div>
  </aside>

  <!-- Main Content -->
  <div class="md:ml-64 lg:mr-80 flex flex-col min-h-screen">

    <!-- Top Navbar -->
    <header class="bg-admin-light px-6 py-4 flex justify-between items-center shadow-lg border-b border-gray-700 sticky top-0 z-10">
      <h1 class="text-xl font-bold text-accent">Admin</h1>
      <p class="text-sm text-gray-300">Welcome, <%= admin.name %> 👋</p>
    </header>

    <main class="p-8 flex-1 overflow-y-auto">
      <!-- Stats Section -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
        <div class="bg-admin-light p-6 rounded-2xl shadow-lg border border-gray-700">
          <p class="text-gray-400">Total Reports</p>
          <h2 class="text-2xl font-bold text-accent"><%= stats.total %></h2>
        </div>
        <div class="bg-admin-light p-6 rounded-2xl shadow-lg border border-gray-700">
          <p class="text-gray-400">Open</p>
          <h2 class="text-2xl font-bold text-yellow-400"><%= stats.open %></h2>
        </div>
        <div class="bg-admin-light p-6 rounded-2xl shadow-lg border border-gray-700">
          <p class="text-gray-400">Resolved</p>
          <h2 class="text-2xl font-bold text-green-400"><%= stats.resolved %></h2>
        </div>
        <div class="bg-admin-light p-6 rounded-2xl shadow-lg border border-gray-700">
          <p class="text-gray-400">Escalated</p>
          <h2 class="text-2xl font-bold text-red-400"><%= stats.escalated %></h2>
        </div>
      </div>

      <!-- Urgent Alerts -->
      <h2 class="text-xl font-semibold mb-4 text-red-400">⚠ Urgent Problems</h2>
      <% if (urgentReports.length > 0) { %>
        <ul class="space-y-4 mb-10">
          <% urgentReports.forEach(report => { %>
            <li class="bg-admin-light border border-red-500/40 p-4 rounded-xl shadow-md">
              <h3 class="font-bold text-lg text-white"><%= report.title %></h3>
              <p class="text-sm text-gray-400"><%= report.location %></p>
              <p class="text-sm">Priority:
                <span class="font-semibold text-red-400"><%= report.priority %></span>
              </p>
              <p class="text-sm text-gray-300">Status: <%= report.status %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="text-gray-400 mb-10">No urgent problems right now 🚀</p>
      <% } %>

      <!-- All Reports -->
      <h2 class="text-xl font-semibold mb-4">📋 Latest Reports</h2>
      <div class="bg-admin-light rounded-xl shadow-lg overflow-hidden border border-gray-700">
        <table class="w-full text-left border-collapse">
          <thead class="bg-brand-light text-offwhite uppercase text-sm">
            <tr>
              <th class="px-4 py-3">Title</th>
              <th class="px-4 py-3">Dept</th>
              <th class="px-4 py-3">Priority</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Created</th>
            </tr>
          </thead>
          <tbody>
            <% reports.forEach(r => { %>
              <tr class="border-t border-gray-700 hover:bg-brand transition">
                <td class="px-4 py-3"><%= r.title %></td>
                <td class="px-4 py-3 text-gray-300"><%= r.department %></td>
                <td class="px-4 py-3">
                  <% if (r.priority === 'High') { %>
                    <span class="text-red-400 font-semibold"><%= r.priority %></span>
                  <% } else if (r.priority === 'Medium') { %>
                    <span class="text-yellow-400 font-semibold"><%= r.priority %></span>
                  <% } else { %>
                    <span class="text-green-400 font-semibold"><%= r.priority %></span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-gray-300"><%= r.status %></td>
                <td class="px-4 py-3 text-sm text-gray-500"><%= r.createdAt.toDateString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Mobile Bottom Nav -->
<nav class="fixed bottom-0 left-0 w-full bg-admin-light border-t border-gray-700 shadow-lg flex justify-around py-3 md:hidden">
    <a href="/admin" class="text-gray-300 hover:text-accent flex flex-col items-center text-sm">
      📊 <span>Dashboard</span>
    </a>
    <a href="/admin/reports" class="text-gray-300 hover:text-accent flex flex-col items-center text-sm">
      📝 <span>Reports</span>
    </a>
       <a href="/admin/actions" class="text-gray-300 hover:text-red-400 flex flex-col items-center text-sm">
      🔘 <span>Actions</span>
    </a>
    <a href="/admin/settings" class="text-gray-300 hover:text-accent flex flex-col items-center text-sm">
      ⚙ <span>Settings</span>
    </a>
 
  </nav>

</body>
</html>
